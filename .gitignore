# ---------------------------------------------------------------
# Rifflect: Expo / React Native app (see specs/001-guitar-practice-feedback/plan.md)
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects generated by `npx expo prebuild` (Continuous Native Generation).
# Only the root-level folders are ignored; local modules keep their native code.
/ios/
/android/

# Metro / bundler
.metro-health-check*
*.bundle
*.jsbundle

# TypeScript
*.tsbuildinfo

# Testing & coverage
coverage/
.jest-cache/
*.lcov
# Maestro end-to-end run output
e2e/.maestro/
e2e/results/

# Accuracy evaluation: the labelled corpus (recordings of real people) and generated reports
# stay out of git. Small anonymised fixtures in tests/fixtures/ ARE committed.
tools/eval/corpus/
tools/eval/output/
tools/eval/**/__pycache__/
tools/eval/.venv/

# iOS / Xcode artefacts (in case native folders are built locally)
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
Pods/
*.ipa
*.dSYM.zip
*.dSYM

# Android / Gradle artefacts
.gradle/
build/
local.properties
*.apk
*.aab
*.hprof
.cxx/
.externalNativeBuild/

# Signing keys, certificates & credentials: never commit
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
credentials.json
google-services.json
GoogleService-Info.plist

# Environment variables
.env
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code: personal local settings (shared project skills/settings ARE committed)
.claude/settings.local.json

# Expo template extras
.kotlin/
*.orig.*
